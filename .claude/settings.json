{
  "permissions": {
    "allow": [
      "Bash(xcodebuild *)",
      "Bash(swift build*)",
      "Bash(swift test*)",
      "Bash(*/xcprojformatter *)",
      "Bash(xcprojformatter *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(mkdir -p docs/*)"
    ],
    "deny": [
      "Bash(git push*)",
      "Edit(**/project.pbxproj)",
      "Write(**/project.pbxproj)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check-translations.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format-xcproj.sh",
            "timeout": 60
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format-swift.sh",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
